# Copy to .env (git-ignored) and fill in. Never commit tokens.

# Deployed Autogration API, including /api/v1. Open <web app>/api/v1/users/me/api-access
# in a signed-in browser to see base_url and token_scope for your environment.
# Leave as localhost for a local backend started with AUTOGRATION_RUN_ENV=LOCAL.
AUTOGRATION_API_URL=http://localhost:5201/api/v1

# How to authenticate: auto | browser | device-code | azure-cli | token | none
#   auto: token if AUTOGRATION_TOKEN is set, none for localhost, otherwise browser.
#   browser/device-code sign in with azure-identity as the Azure CLI client, which the
#   backend accepts by default (ALLOWED_CLIENT_APPS); azure-cli needs `az` installed.
AUTOGRATION_AUTH=auto

# token_scope from /users/me/api-access, e.g. api://<app-id>/access_as_user
AUTOGRATION_API_SCOPE=

# Aker BP Entra tenant id (needed for browser/device-code sign-in).
AZURE_TENANT_ID=

# Optional: a bearer token copied from <web app>/api/v1/users/me/token (expires).
AUTOGRATION_TOKEN=

# Optional named environments. A project that says `environment: <name>` uses the pair
# AUTOGRATION_<NAME>_API_URL / AUTOGRATION_<NAME>_API_SCOPE instead of the default above,
# so projects on different environments can live side by side in one data folder.
# AUTOGRATION_TEST_API_URL=https://<test web app>/api/v1
# AUTOGRATION_TEST_API_SCOPE=api://<app-id>/access_as_user

# Where downloads, manifests and confidential study inputs live (git-ignored).
STUDY_DATA_DIR=data
