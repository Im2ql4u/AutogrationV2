{
    "git.decorations.enabled": false,
    "python.testing.pytestArgs": [
        "tests"
    ],
    "[python]": {
        "editor.defaultFormatter": "charliermarsh.ruff"
    },
    "python.defaultInterpreterPath": "${workspaceFolder}/autogration/.venv/Scripts/python.exe",
    "python.envFile": "${workspaceFolder}/autogration/.env",
    "python.terminal.useEnvFile": true,
    "editor.rulers": [
        88
    ],
    "python.testing.unittestEnabled": false,
    "python.testing.pytestEnabled": true,
    "debugpy.debugJustMyCode": false,
    "mypy-type-checker.ignorePatterns": [
        "samples/.*"
    ],
    "editor.formatOnSave": true,
    "files.watcherExclude": {
        "**/.git/objects/**": true,
        "**/.git/subtree-cache/**": true,
        "**/node_modules/*/**": true,
        "**/.venv/**": true,
        "**/.terraform/**": true,
        "**/samples/**": true,
        "**/kladd/**": true,
        "**/.azureitem/**": true
    },
    "search.exclude": {
        "**/node_modules": true,
        "**/.venv": true,
        "**/.terraform": true,
        "**/bower_components": true,
        "**/*.code-search": true,
        "**/samples/**": true,
        "**/kladd/**": true,
        "**/.azureitem/**": true
    },
    "files.exclude": {
        "**/.git": true,
        "**/.svn": true,
        "**/.hg": true,
        "**/CVS": true,
        "**/.DS_Store": true,
        "**/Thumbs.db": true,
        "**/.azurite": true
    },
    "files.eol": "\r\n",
    "jupyter.notebookFileRoot": "${fileDirname}s",
    "cSpell.words": [
        "AASEN",
        "aggrid",
        "Aker",
        "akerbp",
        "ALVHEIM",
        "argnames",
        "argvalues",
        "assumptionset",
        "assumptionsets",
        "autogration",
        "autouse",
        "AVALS",
        "azcopy",
        "azurewrapper",
        "basefile",
        "cmdkey",
        "cognite",
        "consolelogs",
        "coro",
        "creds",
        "Datapoints",
        "Delfi",
        "dotenv",
        "EDVARD",
        "fdplan",
        "Flowline",
        "formparsers",
        "funcs",
        "Ginj",
        "Greq",
        "INLCHK",
        "INLGEN",
        "INLINJ",
        "INLSEP",
        "Instr",
        "isort",
        "IVAR",
        "jscode",
        "mgmt",
        "Mult",
        "Nasuni",
        "ndarray",
        "nodeclient",
        "OPENFILE",
        "openserver",
        "petex",
        "PETEXPXLS",
        "privatelink",
        "pydantic",
        "pyproject",
        "pythoncom",
        "readall",
        "REGSERVER",
        "selectbox",
        "SKUS",
        "smbprotocol",
        "stateclass",
        "stateclasses",
        "Stepch",
        "Stratos",
        "Streamlit",
        "SVERDRUP",
        "taskfile",
        "tempdisk",
        "unflatten",
        "UNITNAME",
        "upserted",
        "VALHALL",
        "Visc",
        "VLPIPR",
        "Waterflood",
        "YGGDRASIL"
    ],
    "terminal.integrated.defaultProfile.windows": "PowerShell",
    "cSpell.language": "en-GB",
    "chat.tools.terminal.autoApprove": {
        "/^\\s*(uv\\s+run\\s+)?ruff(\\s|$)/": true,
        "/^\\s*(uv\\s+run\\s+)?(python\\s+-m\\s+)?pytest(\\s|$)/": true,
        "/^\\s*(uv\\s+run\\s+)?(python\\s+-m\\s+)?mypy(\\s|$)/": true,
        "/^\\s*(uv\\s+run\\s+)?(python\\s+-m\\s+)?black(\\s|$)/": true,
        "/^\\s*(uv\\s+run\\s+)?(python\\s+-m\\s+)?isort(\\s|$)/": true,
        "/^\\s*npm\\.(cmd\\s+)?run\\s+(test|lint|format)(\\s|$)/": true,
        "/^\\s*npm\\.(cmd\\s+)?(test|run test)(\\s|$)/": true,
        "/^\\s*(npx\\s+)?(vitest|eslint|prettier|tsc)(\\s|$)/": true
    },
    "sqltools.connections": [
        {
            "ssh": "Disabled",
            "previewLimit": 50,
            "server": "localhost",
            "port": 5432,
            "driver": "PostgreSQL",
            "name": "Autogration PG",
            "database": "autogration",
            "username": "user",
            "password": "pass"
        }
    ]
}